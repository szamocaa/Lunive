rules_version = '2';
// Lunive's Firestore rules: Kyuchi ID saves, Account IDs, the leaderboard, and the creator's tools.
// Paste all of this into Firebase console -> Firestore Database -> Rules, and press Publish.
// Nothing to change in it: the creator is whoever owns Account ID #999999999.
service cloud.firestore {
  match /databases/{database}/documents {

    // the creator: the account that owns #999999999. That ID was given once, to the creator,
    // and can never be created again, changed or deleted.
    function isCreator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/ids/999999999)
        && get(/databases/$(database)/documents/ids/999999999).data.uid == request.auth.uid;
    }
    function me(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // what a player's public card may hold
    function okCard(d) {
      return d.n is string && d.n.size() <= 24
        && d.tro is int && d.tro >= 0 && d.tro <= 10000000
        && (!('best' in d) || (d.best is int && d.best >= 0 && d.best <= 10000000))
        && (!('pf' in d) || (d.pf is string && d.pf.size() <= 40))
        && (!('fr' in d) || (d.fr is string && d.fr.size() <= 40))
        && (!('nc' in d) || (d.nc is string && d.nc.size() <= 40))
        && (!('ti' in d) || (d.ti is string && d.ti.size() <= 60))
        && (!('adm' in d) || d.adm is bool)
        && (!('v' in d) || (d.v is string && d.v.size() <= 16))
        && (!('at' in d) || d.at is int)
        && (!('pp' in d) || (d.pp is string && d.pp.size() <= 3000));
    }

    // your save, and your username's sign-in: only you
    match /kyuchi/{uid} { allow read, write: if me(uid); }
    match /alias/{uid}  { allow read, write: if me(uid); }

    // Account IDs: 9 digits, given once per account, never changed and never used again.
    // #999999999 is the creator's alone.
    match /ids/{aid} {
      allow read: if true;
      allow create: if request.auth != null
        && aid.matches('[1-9][0-9]{8}')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && ((aid != '999999999' && !exists(/databases/$(database)/documents/players/$(request.auth.uid)))
            || (aid == '999999999' && isCreator()));
    }

    // a player's public card: the leaderboard and profiles read it; only the creator can ban or limit
    match /players/{uid} {
      allow read: if true;
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['aid', 'n', 'tro', 'best', 'pf', 'fr', 'nc', 'ti', 'adm', 'v', 'at', 'pp'])
        && request.resource.data.aid is string
        && getAfter(/databases/$(database)/documents/ids/$(request.resource.data.aid)).data.uid == uid
        && okCard(request.resource.data);
      allow update: if me(uid)
        && resource.data.get('banned', false) != true
        && request.resource.data.keys().hasOnly(['aid', 'n', 'tro', 'best', 'pf', 'fr', 'nc', 'ti', 'adm', 'v', 'at', 'pp', 'banned', 'why', 'bat', 'lim', 'lw'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aid', 'banned', 'why', 'bat', 'lim', 'lw'])
        && okCard(request.resource.data);
      allow update, delete: if isCreator();
      allow delete: if me(uid) && resource.data.get('banned', false) != true;

      // letters from the creator, with gifts: only the creator sends them, only you open them
      match /mail/{mid} {
        allow read: if me(uid) || isCreator();
        allow create, delete: if isCreator();
        allow update: if isCreator()
          || (me(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
              && request.resource.data.claimed == true);
      }
    }

    // gifts for everyone with a Kyuchi ID: only the creator sends them
    match /bcast/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isCreator();
    }

    // a player's own title: the creator names it and gives it to one Account ID; everyone can see whose it is
    match /xt/{id} {
      allow read: if true;
      allow create, update: if isCreator()
        && request.resource.data.keys().hasOnly(['t', 'a', 'at'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 30
        && request.resource.data.a is string && request.resource.data.a.matches('[1-9][0-9]{8}');
      allow delete: if isCreator();
    }

    // only the creator can read here: it's how the game knows it's you
    match /admin/{doc} { allow read: if isCreator(); }
  }
}
